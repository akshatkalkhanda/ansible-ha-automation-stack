#####################################################################
# haproxy.cfg — managed by Ansible, do not edit manually
# Generated for: {{ inventory_hostname }}
#####################################################################

global
    log {{ haproxy_log_socket }} {{ haproxy_log_facility_global }}
    log {{ haproxy_log_socket }} {{ haproxy_log_facility_notice }} notice
    chroot {{ haproxy_chroot_dir }}
    stats socket {{ haproxy_socket_path }} mode 660 level admin expose-fd listeners
    stats timeout {{ haproxy_stats_timeout }}
    user  {{ haproxy_user }}
    group {{ haproxy_group }}
    daemon
    maxconn {{ haproxy_maxconn }}

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect {{ haproxy_timeout_connect }}
    timeout client  {{ haproxy_timeout_client }}
    timeout server  {{ haproxy_timeout_server }}
    errorfile 400 {{ haproxy_errors_dir }}/400.http
    errorfile 403 {{ haproxy_errors_dir }}/403.http
    errorfile 408 {{ haproxy_errors_dir }}/408.http
    errorfile 500 {{ haproxy_errors_dir }}/500.http
    errorfile 502 {{ haproxy_errors_dir }}/502.http
    errorfile 503 {{ haproxy_errors_dir }}/503.http
    errorfile 504 {{ haproxy_errors_dir }}/504.http

{% if haproxy_stats_enabled %}
#---------------------------------------------------------------------
# Stats endpoint
#---------------------------------------------------------------------
frontend stats
    bind *:{{ haproxy_stats_port }}
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats realm {{ haproxy_stats_realm }}
    stats auth {{ haproxy_stats_auth_user }}:{{ haproxy_stats_auth_pass }}
    stats refresh {{ haproxy_stats_refresh }}
    stats show-legends
    stats show-node
{% endif %}

#---------------------------------------------------------------------
# Main HTTP frontend with URL-based ACL routing
#---------------------------------------------------------------------
frontend {{ haproxy_frontend_name }}
    bind *:{{ haproxy_frontend_port }}
    mode http

{% for route in haproxy_acl_routes %}
    acl {{ route.acl_name }} path_beg {{ route.path_prefix }}
{% endfor %}

{% for route in haproxy_acl_routes %}
    use_backend {{ route.backend_name }} if {{ route.acl_name }}
{% endfor %}

    default_backend {{ haproxy_default_backend }}

#---------------------------------------------------------------------
# Backend pools
#---------------------------------------------------------------------
{% for backend in haproxy_backends %}
backend {{ backend.name }}
    mode http
    balance {{ backend.balance }}
{% for opt in backend.options | default([]) %}
    {{ opt }}
{% endfor %}
{% for server in backend.servers %}
    server {{ server.name }} {{ server.host }}:{{ server.port }} {{ server.options | default('') }}
{% endfor %}

{% endfor %}
