# keepalived.conf — managed by Ansible, do not edit manually
# Generated for: {{ inventory_hostname }}
# Role: {{ keepalived_state }} (priority {{ keepalived_priority }})

global_defs {
    router_id {{ inventory_hostname }}
    script_user root
    enable_script_security
}

vrrp_script chk_haproxy {
    script "{{ keepalived_check_script }}"
    interval {{ keepalived_check_interval }}
    fall    {{ keepalived_check_fall }}
    rise    {{ keepalived_check_rise }}
    weight  {{ keepalived_check_weight }}
}

vrrp_instance {{ keepalived_vrrp_instance_name }} {
    state          {{ keepalived_state }}
    interface      {{ keepalived_interface }}
    virtual_router_id {{ keepalived_vrrp_id }}
    priority       {{ keepalived_priority }}
    advert_int     {{ keepalived_advert_int }}
    preempt_delay  {{ keepalived_preempt_delay }}

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ keepalived_vip }}/{{ keepalived_vip_cidr }} dev {{ keepalived_interface }}
    }

    track_script {
        chk_haproxy
    }
{% if keepalived_notify_script | length > 0 %}

    notify {{ keepalived_notify_script }}
{% endif %}
}
